# ---- Product data -----------------------------------------------------------
# Published Google Sheet ID (File > Share > Publish to web, or "Anyone with link")
SHEET_ID=1HvYsBJ8TpL_JuWAs59lYpTWJHQjE9VM7IjLXq6Nte-M
# gid of the accounting/inventory tab (tab 1)
SHEET_GID_INVENTORY=0
# gid of the additive "Catalog" tab (descriptions, images, SEO). Leave blank until created.
SHEET_GID_CATALOG=
# Optional: read the catalog from any CSV URL instead of a Sheet tab (overrides SHEET_GID_CATALOG)
SHEET_CATALOG_URL=
# Seconds between background re-fetches of the sheet (ISR)
REVALIDATE_SECONDS=300

# ---- Store ------------------------------------------------------------------
# Canonical origin. No trailing slash. This is the base for every canonical tag,
# sitemap URL and schema @id — a wrong value here breaks all three silently.
NEXT_PUBLIC_SITE_URL=https://houseofcharly.com
NEXT_PUBLIC_WA_NUMBER=919518859359
NEXT_PUBLIC_FREE_SHIPPING_OVER=999
NEXT_PUBLIC_SHIPPING_FLAT=79
# Days a customer has to raise a damaged/incorrect item. Must match /returns —
# it is published as MerchantReturnPolicy structured data.
NEXT_PUBLIC_RETURN_DAYS=2

# ---- Business identity (structured data) ------------------------------------
# Feeds the OnlineStore schema: address, social profiles. The real shop address
# (Hisar, Haryana — confirmed against the Google Business Profile listing) is
# already hard-coded as the default in src/lib/site.ts, so these only need to be
# set here if the shop ever relocates. Leave blank to use that default.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_LOCALITY=
NEXT_PUBLIC_REGION=
NEXT_PUBLIC_POSTAL_CODE=
# Social profiles -> schema.org sameAs. How Google links site and accounts.
# Instagram already defaults to instagram.com/houseofcharly.in in site.ts.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ---- Search Console (optional) ----------------------------------------------
# Only needed if you verify by HTML tag instead of DNS. Paste just the token
# from content="..." — not the whole meta tag.
GOOGLE_SITE_VERIFICATION=

# ---- Analytics (optional — leave blank to disable) --------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Payments (Razorpay) ----------------------------------------------------
# Leave BOTH blank to hide online payment and show Cash on Delivery only.
# Get these from Razorpay Dashboard > Account & Settings > API Keys.
# RAZORPAY_KEY_SECRET is server-only — it must NEVER be prefixed NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Order notifications ----------------------------------------------------
# Full setup guide, with step-by-step instructions: docs/ORDER-NOTIFICATIONS.md
#
# Each channel switches itself on when its variables are set, and they are
# independent — one being down never stops the others, and none of them can
# fail a customer's order. Set up AT LEAST ONE, or orders exist nowhere but a
# rolling server log.

# 1. Sheet + email. A Google Apps Script /exec URL bound to your sheet: writes
#    every order into an "Orders" tab (newest first, with a status + courier
#    tracking workflow) and emails you a copy. This is the only channel that
#    creates a permanent, searchable record — set this one up.
#    The secret must match SHARED_SECRET inside the script. The endpoint has to
#    be publicly reachable, so the secret is what stops strangers posting fake
#    orders into your sheet. Optional, but it costs nothing.
ORDERS_WEBHOOK_URL=
ORDERS_WEBHOOK_SECRET=

# 2. Telegram — instant free push to your phone. Token from @BotFather; chat ID
#    from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the
#    bot once. Group IDs are negative — keep the minus sign.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Email via Resend (free to 3,000/month). Works with no DNS setup, but until
#    you verify a domain it only delivers to the address that owns the Resend
#    account. Both address vars are optional and have sensible defaults.
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=
